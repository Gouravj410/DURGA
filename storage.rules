rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Emergency audio recordings
    // Uploaded by citizen during active incident; playable by guardian and responder
    match /emergency_recordings/{audioFile} {
      // Audio size limit: max 5MB for controlled 5-second sample
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && (request.resource.contentType.matches('audio/.*') || request.resource.contentType == 'application/octet-stream');

      // Responders and contacts can read/stream emergency audio
      allow read: if true;
    }
  }
}
