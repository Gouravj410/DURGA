    <string name="btn_call_helpline">112 वर कॉल करा</string>
    <string name="btn_view_map">नेव्हिगेशन उघडा</string>

    <!-- Prompts & Dialogs -->
    <string name="prompt_are_you_safe">तुम्ही सुरक्षित आहात का?</string>
    <string name="prompt_are_you_safe_sub">ध्वनी विश्लेषण अनिश्चित होते. तुमच्या सुरक्षिततेची पुष्टी करा किंवा मदतीची विनंती करा.</string>
    <string name="prompt_enter_pin">४-अंकी सुरक्षा पिन प्रविष्ट करा</string>
    <string name="prompt_pin_attempts_left">उर्वरित प्रयत्न: %1$d</string>
    <string name="prompt_pin_locked">खूप चुकीचे प्रयत्न. रद्दीकरण लॉक केले गेले.</string>
    <string name="prompt_pin_incorrect">चुकीचा पिन प्रविष्ट केला.</string>
    <string name="prompt_repeat_sos_warning">पुनरावृत्ती SOS रद्दीकरण लॉक करेल आणि केवळ अधिकृत प्रतिसादकच ते सोडवू शकतील.</string>

    <!-- Helplines -->
    <string name="helpline_police_title">राष्ट्रीय आणीबाणी सेवा / पोलीस</string>
