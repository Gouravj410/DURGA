    <string name="perm_location_title">स्थान सेवा (GPS)</string>
    <string name="perm_location_desc">प्रतिसादकांना मार्गदर्शन करण्यासाठी आणि १ किमीच्या आतील नागरिकांना सावध करण्यासाठी आवश्यक.</string>
    <string name="perm_audio_title">मायक्रोफोन प्रवेश</string>
    <string name="perm_audio_desc">SOS दरम्यान ५ सेकंदांच्या ध्वनी संकट मूल्यांकनासाठी आवश्यक.</string>
    <string name="perm_notification_title">पुश सूचना</string>
    <string name="perm_notification_desc">जवळपासच्या आणीबाणीच्या तत्काळ सूचना मिळवण्यासाठी आवश्यक.</string>

    <!-- Notifications -->
    <string name="notif_channel_name">दुर्गा आणीबाणी अलर्ट</string>
    <string name="notif_channel_desc">१ किमीच्या आतील जीवन-सुरक्षा घटनांसाठी उच्च-प्राधान्य सूचना.</string>
    <string name="notif_service_title">दुर्गा सुरक्षा मॉनिटर सक्रिय</string>
    <string name="notif_service_action_sos">SOS सक्रिय करा</string>
    <string name="notif_alert_title">दुर्गा आणीबाणी अलर्ट</string>
    <string name="notif_alert_body">%1$s अंतरावर नागरिक संकटात असल्याचे आढळले. स्थान पाहण्यासाठी टॅप करा.</string>

    <!-- Error States -->
    <string name="err_no_location">GPS स्थान मिळवण्यात अक्षम. पुन्हा प्रयत्न करत आहे...</string>
    <string name="err_audio_failed">ऑडिओ रेकॉर्डिंग अयशस्वी. अलर्ट थेट पाठवला जात आहे.</string>
    <string name="err_network_offline">ऑफलाइन मोडमध्ये कार्यरत. घटना स्थानिक पातळीवर सुरक्षित आहेत.</string>
    <string name="err_unauthorized">ऑपरेशन अनधिकृत आहे.</string>
