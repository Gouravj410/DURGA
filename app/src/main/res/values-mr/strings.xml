<resources>
    <string name="app_name">दुर्गा (DURGA)</string>
    <string name="app_tagline">डायनॅमिक युनिफाइड रिस्पॉन्स आणि भू-सूचना प्रणाली</string>
    <string name="app_description">दुर्गा हे एक स्वायत्त आपत्कालीन प्रतिसाद व्यासपीठ आहे जे ऑन-डिव्हाइस संकट मूल्यांकन, शून्य-विलंब घटना प्रेषण आणि सत्यापित प्रतिसादक समन्वय प्रदान करते.</string>

    <!-- Operational States -->
    <string name="status_protected">संरक्षित — सेन्सर्स सक्रिय</string>
    <string name="status_emergency">आणीबाणी सक्रिय</string>
    <string name="status_idle">स्टँडबाय — सज्ज</string>
    <string name="status_triggered">ट्रिगर आढळला</string>
    <string name="status_recording">ध्वनी रेकॉर्डिंग सुरू (५ सेकंद)</string>
    <string name="status_analyzing">स्थानिक संकट विश्लेषण सुरू</string>
    <string name="status_verifying">सुरक्षा स्थितीची पुष्टी केली जात आहे</string>
    <string name="status_escalating">आणीबाणी अलर्ट पाठवला जात आहे</string>
    <string name="status_repeat_active">पुनरावृत्ती SOS — सामान्य रद्दीकरण अक्षम</string>
    <string name="status_acknowledged">प्रतिसादकाकडून स्वीकारले गेले</string>
    <string name="status_responding">मदत पथक मार्गावर आहे</string>
    <string name="status_resolved">घटनेचे निराकरण झाले</string>
    <string name="status_cancelled">घटना रद्द केली गेली</string>

    <!-- Action Buttons -->
    <string name="emergency_btn_text">SOS दाबून ठेवा</string>
    <string name="emergency_cancel">पिनसह रद्द करा</string>
    <string name="btn_repeat_sos">पुन्हा SOS दाबा</string>
    <string name="btn_safe_confirm">मी सुरक्षित आहे</string>
    <string name="btn_need_help">मला मदत हवी आहे</string>
