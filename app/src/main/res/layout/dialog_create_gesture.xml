<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/durga_surface_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configure Custom SOS Gesture"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Define trigger parameters for motion or in-app touch pattern"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Gesture Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Gesture Name (e.g. Rapid 4-Shake)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDialogGestureName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Gesture Type Radio Group -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Gesture Type:"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgDialogGestureType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbDialogMotion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Motion Shake"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/rbDialogTouch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Touch Pattern"
                android:textColor="@color/text_primary" />
        </RadioGroup>

        <!-- Motion Parameters Container -->
        <LinearLayout
            android:id="@+id/layoutDialogMotionParams"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSensitivityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Acceleration Sensitivity: 13.0 m/s²"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbDialogSensitivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="25"
                android:progress="13" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Gentle (8.0)"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vigorous (25.0)"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCountLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Required Shakes: 3"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbDialogCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="6"
                android:min="2"
                android:progress="3" />

            <TextView
                android:id="@+id/tvWindowLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Time Window: 1.5 seconds"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbDialogWindow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="30"
                android:min="10"
                android:progress="15" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Shake Speed / Window: Very Fast (1.0s) • Fast (1.5s) • Average (2.0s) • Deliberate (3.0s)"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Touch Pattern Parameters Container -->
        <LinearLayout
            android:id="@+id/layoutDialogTouchParams"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Draw your secret SOS pattern on the canvas:"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <com.durga.emergency.ui.gesture.GestureDrawingView
                android:id="@+id/drawingViewDialog"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnDialogClearCanvas"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="Clear Canvas"
                android:textColor="@color/durga_blue_accent"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Primary Checkbox -->
        <CheckBox
            android:id="@+id/cbDialogSetPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:checked="false"
            android:text="Set as Primary SOS Trigger"
            android:textColor="@color/text_primary" />

    </LinearLayout>
</ScrollView>
