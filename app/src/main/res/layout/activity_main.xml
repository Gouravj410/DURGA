<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/durga_dark_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- ======================================================== -->
            <!-- 1. AUTHENTIC EXECUTIVE APP BAR                           -->
            <!-- ======================================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_shield_verified"
                    android:contentDescription="DURGA Defense Shield" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tvAppName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DURGA"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tvTagline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CIVIC EMERGENCY DEFENSE NETWORK"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />
                </LinearLayout>

                <!-- Gesture Sensor Configuration Action -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGestureSettings"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_action_circle"
                    app:icon="@drawable/ic_settings_gear"
                    app:iconTint="@color/text_secondary"
                    app:iconSize="20dp"
                    app:iconGravity="textStart"
                    android:padding="0dp"
                    android:contentDescription="Sensor &amp; Gesture Settings" />

                <!-- Citizen Account & Device Profile Action -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAccountProfile"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_action_circle"
                    app:icon="@drawable/ic_user_profile"
                    app:iconTint="@color/text_secondary"
                    app:iconSize="20dp"
                    app:iconGravity="textStart"
                    android:padding="0dp"
                    android:contentDescription="Citizen Profile" />
            </LinearLayout>

            <!-- ======================================================== -->
            <!-- 2. SYSTEM DEFENSE STATUS BANNER                          -->
            <!-- ======================================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="14dp"
                app:cardBackgroundColor="@color/durga_surface_dark"
                app:strokeColor="@color/durga_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <!-- Live Pulsing Status Dot -->
                    <View
                        android:id="@+id/viewStatusDot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_badge_safe" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/tvStatusTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_protected"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.04" />

                        <TextView
                            android:id="@+id/tvStatusSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Continuous acoustic threat inference &amp; rapid gesture trigger armed"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24/7 ACTIVE"
                        android:textColor="@color/durga_green_safe"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        android:background="@drawable/bg_status_pill"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ======================================================== -->
            <!-- 3. PROXIMITY ALERT (CIVIL DEFENSE / AMBER ALERT CARD)     -->
            <!-- ======================================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProximityAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/durga_red_surface"
                app:strokeColor="@color/durga_red_bright"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="VICINITY DISTRESS BROADCAST (1.0 KM)"
                            android:textColor="@color/durga_red_bright"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06" />

                        <TextView
                            android:id="@+id/tvProximityDistanceBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_high"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="~50m AWAY"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvProximityVictimName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Citizen Distress Reported"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvProximityAiStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Acoustic AI: Distress Confirmed (95%)"
                        android:textColor="@color/durga_amber_warning"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnProximityViewMap"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="NAVIGATION MAP"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="6dp"
                            app:cornerRadius="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnProximityCall112"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="CALL 112"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/durga_blue_bright"
                            app:strokeColor="@color/durga_blue_accent"
                            android:layout_marginEnd="6dp"
                            app:cornerRadius="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnProximityDismiss"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="SILENCE"
                            android:textSize="11sp"
                            android:textColor="@color/text_muted" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ======================================================== -->
            <!-- 4. CENTERPIECE TACTILE EMERGENCY SOS CONTROLLER           -->
            <!-- ======================================================== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="270dp"
                android:layout_marginTop="12dp">

                <!-- Ambient Outer Halo Pulse Ring -->
                <View
                    android:id="@+id/viewGlowRing"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_sos_ring_pulse" />

                <!-- Authoritative Tactile SOS Trigger Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSos"
                    android:layout_width="190dp"
                    android:layout_height="190dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_sos_tactile"
                    app:backgroundTint="@null"
                    android:text="SOS"
                    android:textColor="@color/white"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    app:cornerRadius="95dp"
                    android:elevation="12dp"
                    android:contentDescription="Emergency SOS Broadcast Button" />

                <!-- Active 5-Second Cancellation Window Overlay -->
                <LinearLayout
                    android:id="@+id/layoutCountdown"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#E6090C12"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvCountdownTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMERGENCY BROADCAST TRIGGERED"
                        android:textColor="@color/durga_red_bright"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tvCountdownNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5"
                        android:textColor="@color/white"
                        android:textSize="64sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCountdownSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dispatching live coordinates and audio to 1.0 km radius..."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancelEmergency"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="@string/emergency_cancel"
                        android:textColor="@color/white"
                        app:strokeColor="@color/durga_card_border"
                        app:cornerRadius="10dp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="TAP SOS OR RAPIDLY SHAKE DEVICE 3 TIMES"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <!-- ======================================================== -->
            <!-- 5. "ARE YOU SAFE?" FALLBACK VERIFICATION CARD             -->
            <!-- ======================================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAreYouSafe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/durga_amber_surface"
                app:strokeColor="@color/durga_amber_warning"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Safety Verification"
                            android:textColor="@color/durga_amber_warning"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSafeCountdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10s"
                            android:textColor="@color/durga_amber_warning"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Distress acoustic score uncertain. Confirm safety or request immediate dispatch."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSafeConfirm"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="I AM SAFE"
                            android:textColor="@color/durga_green_safe"
                            app:cornerRadius="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNeedHelp"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="I NEED HELP"
                            android:textColor="@color/white"
                            app:backgroundTint="@color/durga_red_primary"
                            app:cornerRadius="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ======================================================== -->
            <!-- 6. ACTIVE EMERGENCY CONTROLS (REPEAT SOS / PIN CANCEL)    -->
            <!-- ======================================================== -->
            <LinearLayout
                android:id="@+id/layoutActiveIncidentActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="14dp"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRepeatSos"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="BROADCAST REPEAT SOS"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    app:backgroundTint="@color/durga_red_bright"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelWithPin"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:text="CANCEL ALERT WITH SECRET PIN"
                    android:textColor="@color/text_primary"
                    app:strokeColor="@color/durga_card_border"
                    app:cornerRadius="10dp" />

                <TextView
                    android:id="@+id/tvRepeatSosLockWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Repeat SOS active. Enter secret code to authenticate cancellation."
                    android:textColor="@color/durga_amber_warning"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ======================================================== -->
            <!-- 7. REAL-TIME DEFENSE TELEMETRY TILES                     -->
            <!-- ======================================================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REAL-TIME DEFENSE TELEMETRY"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- GPS Location Tile -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="14dp"
                    app:cardBackgroundColor="@color/durga_card_bg"
                    app:strokeColor="@color/durga_card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_pin_location"
                                android:contentDescription="GPS" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="GPS TARGET"
                                android:textColor="@color/text_muted"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05"
                                android:layout_marginStart="6dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTelemetryGps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="High Accuracy Armed"
                            android:textColor="@color/durga_green_safe"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Acoustic Threat Inference Tile -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="14dp"
                    app:cardBackgroundColor="@color/durga_card_bg"
                    app:strokeColor="@color/durga_card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_waveform_ai"
                                android:contentDescription="Acoustic AI" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ACOUSTIC AI"
                                android:textColor="@color/text_muted"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05"
                                android:layout_marginStart="6dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTelemetryAi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Threat Model Ready"
                            android:textColor="@color/durga_blue_bright"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ======================================================== -->
            <!-- 8. REGISTERED GUARDIAN & PRIMARY CONTACT                  -->
            <!-- ======================================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEmergencyContactUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="14dp"
                app:cardBackgroundColor="@color/durga_card_bg"
                app:strokeColor="@color/durga_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PRIMARY GUARDIAN CONTACT"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/tvUserContactName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Family Contact (+91 9988776655)"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditContact"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="EDIT"
                        android:textColor="@color/durga_blue_bright"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ======================================================== -->
            <!-- 9. EMERGENCY DISPATCH STATION & NATIONAL HELPLINES        -->
            <!-- ======================================================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="14dp"
                app:cardBackgroundColor="@color/durga_card_bg"
                app:strokeColor="@color/durga_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_police_badge"
                            android:contentDescription="Police Station" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NEAREST EMERGENCY DISPATCH"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvNearestStationDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
