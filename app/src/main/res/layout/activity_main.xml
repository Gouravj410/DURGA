                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCallPolice112"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="112 POLICE"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:icon="@drawable/ic_phone_dial"
                            app:iconSize="14dp"
                            app:cornerRadius="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCallWomen1091"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="1091 HELPLINE"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/durga_amber_warning"
                            app:strokeColor="@color/durga_amber_warning"
                            app:icon="@drawable/ic_phone_dial"
                            app:iconTint="@color/durga_amber_warning"
                            app:iconSize="14dp"
                            app:cornerRadius="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
