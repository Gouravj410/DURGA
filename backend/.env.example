# ==============================================================================
# DURGA Central Backend Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS, SERVICE ACCOUNT KEYS, OR SECRETS TO GIT.
# Copy this file to .env and configure for your local or production environment.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development

# Authentication & Security
# In DEVELOPMENT mode, whitelisted mock OTP (123456) is accepted for local testing.
# In PRODUCTION mode, a genuine SMS gateway (e.g. Twilio/Fast2SMS) OTP is strictly verified.
DURGA_AUTH_MODE=DEVELOPMENT

# Cryptographic secret for signing and verifying JWT session tokens (HS256).
# Must be set to a high-entropy string (>= 32 characters) in production.
DURGA_JWT_SECRET=replace_with_a_secure_random_secret_in_production

# Firebase Admin SDK Configuration for Real Internet FCM Push Notifications
# The service account key JSON must be generated in Firebase Console:
# Project Settings -> Service accounts -> Generate new private key.
# Provide either the file path OR the raw JSON string:
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Strict FCM Requirement:
# If "true", the backend will abort startup if Firebase Admin SDK fails to initialize.
# If "false" (default in development), missing Firebase credentials fallback gracefully to local logged dispatch.
DURGA_REQUIRE_FCM=false

# Keepalive & Tunneling Configuration (Optional for remote testing)
# Endpoint URL monitored by backend/scripts/tunnel_keepalive.js
# Example: http://localhost:3000/api/v1/ping or https://your-domain.org/api/v1/ping
DURGA_TUNNEL_URL=http://localhost:3000/api/v1/ping
DURGA_KEEPALIVE_INTERVAL_MS=60000
